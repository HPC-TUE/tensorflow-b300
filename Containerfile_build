FROM nvcr.io/nvidia/cuda-dl-base:25.08-cuda13.0-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV USER_UID=2002
ENV USER_GID=$USER_UID

RUN apt update && apt install -y python3-dev python3-pip curl llvm-18 clang-18 git && apt --only-upgrade install -y python3-pip

COPY install_bazelisk.sh /install_bazelisk.sh
RUN chmod +x /install_bazelisk.sh
RUN /install_bazelisk.sh

# Spike only runs non-root containers, so the build happens as this user
RUN groupadd -g $USER_GID builder && useradd -m -u $USER_UID -g $USER_GID -s /bin/bash builder
RUN mkdir -p /build && chown $USER_UID:$USER_GID /build
COPY tensorflow/.bazelrc /build/bazelrc
COPY build_wheel.sh /build/build_wheel.sh

USER $USER_UID:$USER_GID
ENV HOME=/home/builder
WORKDIR /build
CMD ["sleep", "infinity"]
